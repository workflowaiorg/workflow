package postgres_test

import (
	"context"
	"testing"
	"time"

	"[[ .module ]]/pkg/postgres"
)

func TestOpenLeavesConnectingToTheFirstQuery(t *testing.T) {
	db := postgres.Open("postgres://app:app@127.0.0.1:1/app?sslmode=disable")
	defer db.Close()

	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := db.PingContext(ctx); err == nil {
		t.Error("Ping to a port nothing listens on succeeded, though Open returned a pool")
	}
}
