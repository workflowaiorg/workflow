//go:build integration

package postgres_test

import (
	"context"
	"database/sql"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
	"github.com/uptrace/bun"

	"[[ .module ]]/pkg/errors"
	"[[ .module ]]/pkg/postgres"
	"[[ .module ]]/pkg/postgrestest"
)

func TestRunInTx(t *testing.T) {
	ctx := t.Context()
	database := postgrestest.Start(t)
	db := postgres.Open(database.DSN)
	t.Cleanup(func() { _ = db.Close() })
	_, err := database.DB.ExecContext(ctx, "CREATE TABLE probe (id int)")
	require.NoError(t, err)

	insert := func(ctx context.Context, tx bun.Tx) error {
		_, err := tx.ExecContext(ctx, "INSERT INTO probe VALUES (1)")
		return err
	}
	// insertThen inserts a row, then fails with result.
	insertThen := func(result error) func(context.Context, bun.Tx) error {
		return func(ctx context.Context, tx bun.Tx) error {
			require.NoError(t, insert(ctx, tx))
			return result
		}
	}
	rows := func() int {
		t.Helper()
		var n int
		require.NoError(t, database.DB.QueryRowContext(ctx, "SELECT count(*) FROM probe").Scan(&n))
		return n
	}

	require.NoError(t, postgres.RunInTx(ctx, db, insert))
	require.Equal(t, 1, rows(), "a transaction that succeeds is committed")

	conflict := errors.New(errors.CodeConflict, "Taken", nil)
	assert.Same(t, conflict, postgres.RunInTx(ctx, db, insertThen(conflict)), "an APIError comes back as it is")
	assert.Equal(t, 1, rows(), "a transaction failing with an APIError is rolled back")

	assert.NoError(t, postgres.RunInTx(ctx, db, insertThen(postgres.ErrRollback)))
	assert.Equal(t, 1, rows(), "a transaction returning ErrRollback is rolled back")

	err = postgres.RunInTx(ctx, db, insertThen(sql.ErrConnDone))
	var apiErr *errors.APIError
	require.ErrorAs(t, err, &apiErr)
	assert.Equal(t, errors.CodeInternal, apiErr.Code, "any other error becomes internal")
	assert.ErrorIs(t, err, sql.ErrConnDone, "and keeps its cause")
	assert.Equal(t, 1, rows(), "a transaction failing with another error is rolled back")
}
