package httputil_test

import (
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/gin-gonic/gin"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

	"[[ .module ]]/pkg/errors"
	"[[ .module ]]/pkg/httputil"
)

// request is the context of a request for target, routed through pattern so it has its params.
func request(t *testing.T, pattern, target string) *gin.Context {
	t.Helper()
	gin.SetMode(gin.TestMode)
	var got *gin.Context
	r := gin.New()
	r.GET(pattern, func(c *gin.Context) { got = c.Copy() })
	r.ServeHTTP(httptest.NewRecorder(), httptest.NewRequest(http.MethodGet, target, nil))
	require.NotNil(t, got, "%s does not match %s", target, pattern)
	return got
}

func assertCode(t *testing.T, err error, code errors.Code) {
	t.Helper()
	var apiErr *errors.APIError
	require.ErrorAs(t, err, &apiErr)
	assert.Equal(t, code, apiErr.Code)
}

func TestParsePage(t *testing.T) {
	tests := []struct {
		name   string
		target string
		want   httputil.Page
		fails  bool
	}{
		{name: "no query is the first full page", target: "/", want: httputil.Page{Offset: 0, Limit: 50}},
		{name: "an offset and a limit", target: "/?offset=20&limit=10", want: httputil.Page{Offset: 20, Limit: 10}},
		{name: "the maximum limit", target: "/?limit=50", want: httputil.Page{Limit: 50}},
		{name: "a limit past the maximum", target: "/?limit=51", fails: true},
		{name: "a negative offset", target: "/?offset=-1", fails: true},
		{name: "a zero limit", target: "/?limit=0", want: httputil.Page{Limit: 50}},
		{name: "a limit that is not a number", target: "/?limit=ten", fails: true},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			page, err := httputil.ParsePage(request(t, "/", test.target), 50)
			if test.fails {
				assertCode(t, err, errors.CodeInvalidRequest)
				return
			}
			require.NoError(t, err)
			assert.Equal(t, test.want, page)
		})
	}
}

func TestHasMore(t *testing.T) {
	page := httputil.Page{Offset: 20, Limit: 10}
	assert.True(t, page.HasMore(10, 31))
	assert.False(t, page.HasMore(10, 30))
}

func TestParamID(t *testing.T) {
	tests := []struct {
		target string
		want   int64
		fails  bool
	}{
		{target: "/orders/7", want: 7},
		{target: "/orders/0", fails: true},
		{target: "/orders/-3", fails: true},
		{target: "/orders/seven", fails: true},
	}
	for _, test := range tests {
		t.Run(test.target, func(t *testing.T) {
			id, err := httputil.ParamID(request(t, "/orders/:id", test.target), "id", "order")
			if test.fails {
				assertCode(t, err, errors.CodeInvalidRequest)
				return
			}
			require.NoError(t, err)
			assert.Equal(t, test.want, id)
		})
	}
}

func TestBindQuery(t *testing.T) {
	var q struct {
		Status string `form:"status" binding:"required,oneof=open paid"`
	}
	require.NoError(t, httputil.BindQuery(request(t, "/", "/?status=paid"), &q))
	assert.Equal(t, "paid", q.Status)

	tests := []struct {
		target string
		want   string
	}{
		{target: "/?status=lost", want: "The request is not valid: status must be one of: open, paid"},
		{target: "/?limit=ten&offset=-1", want: "The request is not valid: limit has the wrong type"},
		{target: "/?offset=-1", want: "The request is not valid: offset must be at least 0"},
	}
	for _, test := range tests {
		t.Run(test.target, func(t *testing.T) {
			var q struct {
				Status string `form:"status" binding:"omitempty,oneof=open paid"`
				httputil.PageQuery
			}
			var apiErr *errors.APIError
			require.ErrorAs(t, httputil.BindQuery(request(t, "/", test.target), &q), &apiErr)
			assert.Equal(t, errors.CodeInvalidRequest, apiErr.Code)
			assert.Equal(t, test.want, apiErr.Message)
			assert.NotContains(t, apiErr.Message, "Status")
			assert.NotContains(t, apiErr.Message, "Limit")
		})
	}
}

func TestSplitList(t *testing.T) {
	assert.Equal(t, []string{"a", "b"}, httputil.SplitList(" a, ,b,"))
	assert.Nil(t, httputil.SplitList(""))
}

func TestBindErrorNamesFieldsAsTheClientSendsThem(t *testing.T) {
	type orderRequest struct {
		CustomerID int64    `json:"customer_id" binding:"required"`
		Status     string   `json:"status" binding:"omitempty,oneof=open paid"`
		Note       string   `json:"note" binding:"max=5"`
		SKUs       []string `json:"skus" binding:"min=1"`
	}
	tests := []struct {
		name string
		body string
		want string
	}{
		{
			name: "a broken rule each",
			body: `{"status":"lost","note":"far too long"}`,
			want: "The request is not valid: customer_id is required; status must be one of: open, paid; note must be at most 5 characters long; skus must be at least 1 item",
		},
		{name: "a value of the wrong type", body: `{"customer_id":"seven"}`, want: "The request is not valid: customer_id has the wrong type"},
		{name: "a body that is not JSON", body: `{`, want: "The request is not valid"},
	}
	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			gin.SetMode(gin.TestMode)
			c, _ := gin.CreateTestContext(httptest.NewRecorder())
			c.Request = httptest.NewRequest(http.MethodPost, "/", strings.NewReader(test.body))
			var req orderRequest
			err := httputil.BindError(c.ShouldBindJSON(&req))
			assert.Equal(t, errors.CodeInvalidRequest, err.Code)
			assert.Equal(t, test.want, err.Message)
			assert.NotContains(t, err.Message, "orderRequest")
			assert.NotContains(t, err.Message, "CustomerID")
		})
	}
}
