package config_test

import (
	"testing"

	"[[ .module ]]/api/internal/config"
)

func TestLoad(t *testing.T) {
	t.Setenv("PORT", "")
	if got := config.Load().Port; got != "8000" {
		t.Errorf("Port with no PORT = %q, want 8000", got)
	}
	t.Setenv("PORT", "9000")
	if got := config.Load().Port; got != "9000" {
		t.Errorf("Port with PORT=9000 = %q, want 9000", got)
	}
}
[[- if .postgres ]]

func TestPostgresDSN(t *testing.T) {
	for _, key := range []string{"POSTGRES_HOST", "POSTGRES_PORT", "POSTGRES_USER", "POSTGRES_PASSWORD", "POSTGRES_DB", "POSTGRES_SSLMODE"} {
		t.Setenv(key, "")
	}
	if got := config.Load().PostgresDSN; got != "" {
		t.Errorf("PostgresDSN with no POSTGRES_PASSWORD = %q, want it empty, so main stops", got)
	}
	t.Setenv("POSTGRES_PASSWORD", "p@ss/word")
	if got, want := config.Load().PostgresDSN, "postgres://app:p%40ss%2Fword@postgres:5432/app?sslmode=require"; got != want {
		t.Errorf("PostgresDSN = %q, want the password escaped and TLS required: %q", got, want)
	}
	t.Setenv("POSTGRES_SSLMODE", "disable")
	if got, want := config.Load().PostgresDSN, "postgres://app:p%40ss%2Fword@postgres:5432/app?sslmode=disable"; got != want {
		t.Errorf("PostgresDSN with POSTGRES_SSLMODE=disable = %q, want %q", got, want)
	}
}
[[- end ]]
[[- if .queue ]]

func TestRedisAddr(t *testing.T) {
	t.Setenv("REDIS_ADDR", "")
	if got := config.Load().RedisAddr; got != "redis:6379" {
		t.Errorf("RedisAddr with no REDIS_ADDR = %q, want the local stack's redis:6379", got)
	}
	t.Setenv("REDIS_ADDR", "queue:6380")
	if got := config.Load().RedisAddr; got != "queue:6380" {
		t.Errorf("RedisAddr with REDIS_ADDR=queue:6380 = %q, want queue:6380", got)
	}
}
[[- end ]]
