package main

import (
	"context"
	"errors"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/gin-gonic/gin"

	"[[ .module ]]/api/internal/app"
	"[[ .module ]]/api/internal/config"
	"[[ .module ]]/api/internal/route"
	"[[ .module ]]/pkg/logging"
	"[[ .module ]]/pkg/middleware"
)

func main() {
	logging.Init()
	cfg := config.Load()
	application := app.New(cfg)

	r := gin.New()
	r.Use(gin.Recovery(), middleware.CorrelationID())
	if err := r.SetTrustedProxies(nil); err != nil {
		logging.Error(context.Background(), "setting trusted proxies", "error", err)
		os.Exit(1)
	}
	if err := route.RegisterHealthRoutes(application, r); err != nil {
		logging.Error(context.Background(), "registering the health routes", "error", err)
		os.Exit(1)
	}

	serve(r, cfg.Port)
}

// serve answers on port until SIGINT or SIGTERM, then gives the requests in flight five seconds
// to finish.
func serve(handler http.Handler, port string) {
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	server := &http.Server{Addr: ":" + port, Handler: handler, ReadHeaderTimeout: 10 * time.Second}
	go func() {
		logging.Info(ctx, "listening", "addr", server.Addr)
		if err := server.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			logging.Error(ctx, "listening", "error", err)
			os.Exit(1)
		}
	}()

	<-ctx.Done()
	shutdown, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := server.Shutdown(shutdown); err != nil {
		logging.Error(shutdown, "shutting down", "error", err)
	}
}
