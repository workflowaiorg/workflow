module [[ .module ]]

go 1.25

// Every library the generated code imports, pinned: go mod tidy would take the newest, and a newer
// one may need a newer Go than the line above. A newer kin-openapi or swaggest may also write
// api/openapi.yaml differently, and the test that it is up to date would fail in a project that
// changed nothing.
require (
	github.com/getkin/kin-openapi v0.153.0
	github.com/gin-gonic/gin v1.12.0
	github.com/go-playground/validator/v10 v10.30.1
	github.com/google/uuid v1.6.0
	github.com/stretchr/testify v1.11.1
	github.com/swaggest/jsonschema-go v0.3.79
	github.com/swaggest/openapi-go v0.2.61
	gopkg.in/yaml.v3 v3.0.1
)
[[- if .postgres ]]

require (
	github.com/pressly/goose/v3 v3.27.0
	github.com/testcontainers/testcontainers-go v0.44.0
	github.com/testcontainers/testcontainers-go/modules/postgres v0.44.0
	github.com/uptrace/bun v1.3.0
	github.com/uptrace/bun/dialect/pgdialect v1.3.0
	github.com/uptrace/bun/driver/pgdriver v1.3.0
)
[[- end ]]
[[- if .queue ]]

require (
	github.com/alicebob/miniredis/v2 v2.40.0
	github.com/redis/go-redis/v9 v9.22.0
)
[[- end ]]
[[- if index . "llm-agents" ]]

require (
	github.com/a2aproject/a2a-go/v2 v2.5.0
	github.com/openai/openai-go/v3 v3.74.0
)
[[- end ]]
