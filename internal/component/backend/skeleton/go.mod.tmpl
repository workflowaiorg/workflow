module [[ .module ]]

go 1.25

// The versions api/openapi.yaml was generated with: a newer one may write it differently, and the
// test that it is up to date would fail in a project that changed nothing.
require (
	github.com/getkin/kin-openapi v0.153.0
	github.com/swaggest/jsonschema-go v0.3.79
	github.com/swaggest/openapi-go v0.2.61
)
[[- if .postgres ]]

// The last goose and testcontainers-go that build with Go 1.25; newer ones need Go 1.26.
require (
	github.com/pressly/goose/v3 v3.27.0
	github.com/testcontainers/testcontainers-go v0.44.0
	github.com/testcontainers/testcontainers-go/modules/postgres v0.44.0
)
[[- end ]]
[[- if .queue ]]

// The last go-redis that builds with Go 1.25; a newer one needs Go 1.26.
require github.com/redis/go-redis/v9 v9.22.0
[[- end ]]
[[- if index . "llm-agents" ]]

// The last a2a-go and openai-go that build with Go 1.25; newer ones need Go 1.26.
require (
	github.com/a2aproject/a2a-go/v2 v2.5.0
	github.com/openai/openai-go/v3 v3.74.0
)
[[- end ]]
